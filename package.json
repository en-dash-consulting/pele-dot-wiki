{
  "name": "pele-wiki",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "pages": "node scripts/build-pages.mjs",
    "build": "npm run pages && tsc && vite build",
    "og": "node scripts/generate-og-image.mjs",
    "test": "playwright test",
    "shots": "SHOTS=1 playwright test tests/screenshots.spec.ts",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "mermaid": "12.1.0",
    "pele": "1.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "marked": "^15.0.12",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
