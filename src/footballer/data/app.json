  "views": {
    "home": [
      {
        "headline": "Pelé: {count(all('chapter'))} chapters, {count(all('tournament'))} tournaments, {count(all('match'))} matches that mattered and {count(all('goal'))} famous goals."
      },
      {
        "title": "The story"
      },
      {
        "as": "row",
        "list": "all('chapter')",
        "sort": {
          "by": "order",
          "direction": "asc"
        }
      },
      {
        "title": "The World Cups"
      },
      {
        "as": "card",
        "list": "all('tournament') where name >= 'FIFA'",
        "sort": {
          "by": "year",
          "direction": "asc"
        }
      }
    ],
    "match": {
      "card": [
        {
          "title": "{name}"
        },
        {
          "badge": "{result}",
          "tone": {
            "expr": "if(result == 'won', 'good', if(result == 'lost', 'bad', 'neutral'))"
          }
        },
        {
          "as": "date",
          "field": "date"
        },
        {
          "text": "{stage}"
        }
      ],
      "row": [
        {
          "title": "{name}"
        },
        {
          "text": "{stage}"
        }
      ]
    },
    "tournament": {
      "card": [
        {
          "title": "{name}"
        },
        {
          "badge": "{result}",
          "tone": {
            "expr": "if(result == 'champions', 'good', 'neutral')"
          }
        },
        {
          "text": "{peleGoals} {peleGoals|plural: 'goal'} in {peleApps} {peleApps|plural: 'match'}"
