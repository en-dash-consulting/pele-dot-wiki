{
  "format": "graview-document",
  "formatVersion": 1,
  "name": "Pelé",
  "description": "A wiki on Pelé (Edson Arantes do Nascimento, 1940–2022), the Brazilian footballer: his story in chapters, his four World Cups, his clubs, the matches and goals that made him, the people around him, his honours and the films and books about him. Every record carries its source.",
  "kinds": {
    "chapter": {
      "noun": "chapter",
      "plural": "chapters",
      "label": "{name}",
      "describe": "{began|date} to {ended|date}",
      "description": "A part of his life, told in order: where he was, what happened and why it mattered.",
      "fields": {
        "name": {
          "type": "string",
          "required": true
        },
        "order": {
          "type": "integer",
          "min": 1,
          "max": 99,
          "description": "Its place in the story."
        },
        "began": {
          "type": "date"
        },
        "ended": {
          "type": "date"
        },
        "headline": {
          "type": "string",
          "description": "One sentence that sums the chapter up."
        },
        "story": {
          "type": "text",
          "format": "markdown",
          "description": "The chapter, told."
        },
        "photo": {
          "type": "string",
          "description": "Path of a public-domain or Creative Commons photo on this site."
        },
        "photoCredit": {
          "type": "string",
          "label": "Photo credit"
        },
        "source": {
          "type": "url"
        }
      },
      "edges": {
        "covers": {
          "to": [
            "tournament",
            "match",
            "club",
            "person",
            "goal",
            "honour",
            "work",
            "place"
          ],
          "description": "what the chapter is about",
          "inverse": "the chapters it appears in"
        }
      },
      "glance": [
        "name",
        "began",
        "ended"
      ]
    },
